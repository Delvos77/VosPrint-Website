# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- Admin authentication (Server-side Protection) ----
# Set these in your environment variables for maximum security.
# Never commit real secret keys to public git repositories.

# SESSION_SECRET: long random string used to sign the admin session cookie/tokens.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="vosprint_production_secret_key_random_hash_2026"

# ADMIN_PIN_DEFAULT: default admin PIN on first run (default: 2457).
# Change the PIN from the in-app "Ubah PIN Admin" screen after first login.
ADMIN_PIN_DEFAULT="2457"

# ADMIN_PIN_PEPPER: extra server secret mixed into the cryptographic PIN hash.
ADMIN_PIN_PEPPER="vosprint_security_pepper_salt_secret_2026"
